	author = {Namadmalan, Alireza},
	urldate = {2026-03-05},
	date = {2024-04},
	note = {{ISSN}: 2997-7460},
	keywords = {Buck converters, Power Inductors, Resistance, Accuracy, Analytical models, {DC}-{DC} Converters, {ESR} Calculations, {FEM} Simulations, Solid Flat Wires, Solid modeling, Solids, Wires},
	file = {Full Text PDF:C\:\\Users\\alvar\\Zotero\\storage\\8FTME339\\Namadmalan - 2024 - Modeling of High Power Inductors Based on Solid Flat Wires for Compact DC-DC Converters.pdf:application/pdf},
