@inproceedings{dias_current_2017,
	title = {A current limiting switch for applications in space power systems},
	url = {https://ieeexplore.ieee.org/document/8333594/},
	doi = {10.1109/SPEC.2017.8333594},
	abstract = {The solid-state Current Limiting Switches are used in space missions since the 1990's to improve the power systems reliability of spacecrafts. These switches, also called Latching Current Limiter - {LCL}, protect the spacecraft power bus, providing temporized protection, controlled inrush and limited overcurrent, thus avoiding high current surges. The {LCL} also creates the possibility to restart the loads that suffered temporary failures. This paper presents the complete implementation of a {LCL} for space applications. The basic diagram and timing characteristics of an ideal {LCL} are explained. The real circuit, using qualified components and compliant to the space standards are shown. The practical test results for different temperatures and input voltages are presented and discussed. The implemented hardware worked as expected, showing high stability over the tested ranges.},
	eventtitle = {2017 {IEEE} Southern Power Electronics Conference ({SPEC})},
	pages = {1--6},
	booktitle = {2017 {IEEE} Southern Power Electronics Conference ({SPEC})},
	author = {Dias, Agnaldo Vieira and Pomilio, José Antenor and Finco, Saulo},
	urldate = {2026-03-08},
	date = {2017-12},
